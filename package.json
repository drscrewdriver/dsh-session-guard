{
  "name": "dsh-session-guard",
  "version": "0.1.0",
  "type": "module",
  "description": "高峰自动会话门：高峰时段自动暂停运行会话（经 taskControl 会话门），无会话门时回退只锁等待队列；周末模式识别周末、无视峰谷畅快跑。设置位于 设置 → 插件 → session-guard，简单开关。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "peak",
    "off-peak",
    "weekend",
    "pause",
    "session-gate"
  ],
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
