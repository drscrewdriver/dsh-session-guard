{
  "//": "host 半构建：src/**/*.ts → lib/（tsc emit，无 bundler）。",
  "//strict": "全量 TS 化完成（v4.7.0-rc.4）：allowJs / checkJs 逃生已删除，src 下不再有 .js。",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["src/client/**", "src/**/*.tsx", "node_modules", "lib"]
}
